<UserControl x:Class="FonPrebel.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:FonPrebel.Presentation.Views.Layout"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:config="clr-namespace:FonPrebel.Presentation.ViewModels.Config">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FonPrebel;component/Presentation/Views/Layout/PageLayout.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- §2.9.2 r14: el lápiz y la cancelación de la edición se muestran según el estado del campo. -->
            <BooleanToVisibilityConverter x:Key="FieldStateToVisibility" />

            <!-- Anexo E y §2.9.2 r15: el spinner del campo sólo se ve mientras ese campo valida. -->
            <Style x:Key="FieldProgressRing" TargetType="ui:ProgressRing">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsIndeterminate" Value="True" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsValidating}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Indicador de trabajo en curso de la sección; sólo se ve mientras la pantalla está ocupada. -->
            <Style x:Key="BusyProgressRing" TargetType="ui:ProgressRing">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsIndeterminate" Value="True" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Indicador de la credencial: se guía por el trabajo en curso de su propio bloque. -->
            <Style x:Key="CredentialProgressRing" TargetType="ui:ProgressRing">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsIndeterminate" Value="True" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Credentials.IsBusy}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                Anexo E: etiqueta, campo, spinner de 12 px y mensaje concreto del parámetro.
                §2.9.2 r14: el campo se muestra en sólo lectura y el lápiz habilita su edición; mientras
                edita aparecen las acciones de cancelar.
                §2.9.2 r15: el indicador de progreso va dentro del propio campo mientras comprueba la ruta.
            -->
            <DataTemplate x:Key="ValidatedFieldTemplate" DataType="{x:Type config:ValidatedFieldViewModel}">
                <layout:ResponsiveColumnsPanel Style="{StaticResource PageFormRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageFormLabel}" Text="{Binding Label}" />
                        <TextBlock Style="{StaticResource PageFormHint}" Text="{Binding Hint}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border BorderThickness="1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowsError}" Value="True">
                                                <Setter Property="BorderBrush" Value="#C42B1C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowsSuccess}" Value="True">
                                                <Setter Property="BorderBrush" Value="#0F7B0F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- El spinner vive dentro del campo, sobre el borde que marca su estado. -->
                                <Grid>
                                    <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsEnabled}"
                                                IsReadOnly="{Binding IsReadOnly, Mode=OneWay}" />

                                    <ui:ProgressRing Style="{StaticResource FieldProgressRing}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Message}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PageFormMessage}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Setter Property="Foreground" Value="#0F7B0F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowsError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="#C42B1C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- §2.9.2 r14: el lápiz habilita la edición de este campo y sólo de este. -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                            <ui:Button ToolTip="Editar este campo"
                                       Command="{Binding BeginEditCommand}"
                                       Visibility="{Binding CanBeginEdit, Converter={StaticResource FieldStateToVisibility}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Edit24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Content="Cancelar"
                                       ToolTip="Volver al valor guardado"
                                       Command="{Binding CancelEditCommand}"
                                       Visibility="{Binding IsEditing, Converter={StaticResource FieldStateToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </layout:ResponsiveColumnsPanel>
            </DataTemplate>

            <!-- Fila de contraseña del bloque de credenciales: misma grilla que los campos del formulario. -->
            <Style x:Key="CredentialField" TargetType="ui:PasswordBox">
                <Setter Property="Width" Value="320" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="RevealButtonEnabled" Value="True" />
            </Style>

            <Style x:Key="CredentialLabel" TargetType="TextBlock" BasedOn="{StaticResource PageFormLabel}" />

            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="#0F7B0F" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasStatusError}" Value="True">
                        <Setter Property="Foreground" Value="#C42B1C" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        S25: una sola columna centrada de 960 con relleno de 32. Es un formulario, así que el ancho máximo
        queda por debajo de las vistas de tarjetas para que las líneas de lectura sigan siendo cortas.
    -->
    <layout:PageLayout HeaderTitle="{Binding Title}"
                       HeaderSubtitle="{Binding Description}"
                       ContentMaxWidth="960">
        <layout:PageLayout.Footer>
            <StackPanel>
                <!--
                    §2.9.2 r2: al guardar se ofrece comprobar las conexiones. No se lanza sola, porque una
                    comprobación real toca la red y tarda: la decide el analista. Cuando la sonda no se pudo
                    hacer, el resultado muestra el motivo en lugar de presentarla como un éxito.
                -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnectionOffer}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock VerticalAlignment="Center" Style="{StaticResource StatusText}"
                               Text="{Binding ConnectionOfferMessage}" />

                    <ui:Button Margin="12,0,0,0" Content="Comprobar ahora" Command="{Binding OfferConnectionTestCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="Ahora no" Command="{Binding DismissConnectionOfferCommand}" />
                </StackPanel>

                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding ConnectionOfferResultText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnectionOfferResult}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource StatusText}"
                               Text="{Binding StatusMessage}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="18" Height="18" Style="{StaticResource BusyProgressRing}" />
                        <ui:Button Margin="12,0,0,0" Content="Guardar" Appearance="Primary" MinWidth="120"
                                   Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </layout:PageLayout.Footer>

        <layout:SpacedStackPanel>
            <ui:InfoBar Severity="Error"
                        IsClosable="False"
                        Title="Base de datos no disponible"
                        Message="{Binding StorageErrorText, Mode=OneWay}"
                        IsOpen="{Binding HasStorageError, Mode=OneWay}" />

            <!-- Correo: todos los valores están pendientes de confirmar con TI. -->
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageSectionTitle}" Text="Correo" />
                    <TextBlock Style="{StaticResource PageSectionNote}"
                               Text="Servidor, puerto, seguridad, remitente, cuenta y tiempo de espera. Ningún valor está confirmado todavía: los campos arrancan vacíos y el puerto es obligatorio siempre." />
                    <ItemsControl ItemsSource="{Binding Email.Fields}"
                                  ItemTemplate="{StaticResource ValidatedFieldTemplate}" />
                </StackPanel>
            </ui:Card>

            <!-- Proxy: el interruptor decide si el texto se usa. -->
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageSectionTitle}" Text="Proxy" />
                    <TextBlock Style="{StaticResource PageSectionNote}"
                               Text="El proxy no lleva usuario ni contraseña. Apagado, el campo de texto queda deshabilitado y vacío." />
                    <ui:ToggleSwitch Content="Usar proxy"
                                     Margin="0,0,0,14"
                                     IsChecked="{Binding Proxy.IsProxyEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl ItemsSource="{Binding Proxy.Fields}"
                                  ItemTemplate="{StaticResource ValidatedFieldTemplate}" />
                </StackPanel>
            </ui:Card>

            <!-- Rutas del servidor de archivos: las cuatro son obligatorias. -->
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageSectionTitle}" Text="Rutas del servidor de archivos" />
                    <TextBlock Style="{StaticResource PageSectionNote}"
                               Text="Las rutas las entrega TI. Se comprueba que existan y, en las que la aplicación escribe, que tengan permiso de escritura." />
                    <ItemsControl ItemsSource="{Binding Routes.Fields}"
                                  ItemTemplate="{StaticResource ValidatedFieldTemplate}" />
                </StackPanel>
            </ui:Card>

            <!-- Intervalos y concurrencia: sólo la verificación automática trae valor confirmado. -->
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageSectionTitle}" Text="Intervalos y concurrencia" />
                    <TextBlock Style="{StaticResource PageSectionNote}"
                               Text="La verificación automática de conexiones corre cada 2 minutos. El umbral de conexión lenta y la cantidad de trabajadores están pendientes: se muestran vacíos." />
                    <ItemsControl ItemsSource="{Binding Intervals.Fields}"
                                  ItemTemplate="{StaticResource ValidatedFieldTemplate}" />
                </StackPanel>
            </ui:Card>

            <!-- Credenciales: la contraseña guardada nunca se muestra ni se precarga. -->
            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageSectionTitle}" Text="Credenciales" />
                    <TextBlock Style="{StaticResource PageSectionNote}" Text="{Binding Credentials.StateText}" />

                    <ui:InfoBar Margin="0,0,0,10" Severity="Error" IsClosable="False" Title="Credencial no disponible"
                                Message="{Binding Credentials.StatusMessage, Mode=OneWay}"
                                IsOpen="{Binding Credentials.HasStorageError, Mode=OneWay}" />

                    <!-- §2.10: el perfil de Windows cambió y la credencial guardada no se descifra. -->
                    <ui:InfoBar Margin="0,0,0,10" Severity="Warning" IsClosable="False"
                                Title="Credencial no recuperable en este perfil"
                                Message="{Binding Credentials.ReentryWarningText, Mode=OneWay}"
                                IsOpen="{Binding Credentials.ShowsNotRecoverableWarning, Mode=OneWay}" />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Credentials.IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <layout:ResponsiveColumnsPanel Style="{StaticResource PageFormRow}">
                            <TextBlock Style="{StaticResource CredentialLabel}" Text="Contraseña guardada" />
                            <StackPanel Orientation="Horizontal">
                                <ui:PasswordBox Width="320" HorizontalAlignment="Left" IsEnabled="False"
                                                RevealButtonEnabled="False"
                                                ToolTip="La contraseña guardada nunca se muestra."
                                                Password="{Binding Credentials.StoredCredentialMask, Mode=OneWay}" />
                                <ui:Button Margin="8,0,0,0" Content="{Binding Credentials.EditButtonText}"
                                           ToolTip="Entrar en modo edición de la credencial"
                                           Command="{Binding Credentials.BeginEditCommand}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Edit24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </layout:ResponsiveColumnsPanel>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Credentials.IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Sólo con una credencial utilizable se pide la contraseña anterior (§3.2). -->
                        <Grid Margin="0,0,0,14">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Credentials.RequiresPreviousPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <layout:ResponsiveColumnsPanel Style="{StaticResource PageFormRow}" Margin="0">
                                <TextBlock Style="{StaticResource CredentialLabel}" Text="Contraseña anterior" />
                                <ui:PasswordBox Style="{StaticResource CredentialField}"
                                                Password="{Binding Credentials.PreviousPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </layout:ResponsiveColumnsPanel>
                        </Grid>

                        <layout:ResponsiveColumnsPanel Style="{StaticResource PageFormRow}">
                            <TextBlock Style="{StaticResource CredentialLabel}" Text="{Binding Credentials.NewPasswordLabel}" />
                            <ui:PasswordBox Style="{StaticResource CredentialField}"
                                            Password="{Binding Credentials.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </layout:ResponsiveColumnsPanel>

                        <layout:ResponsiveColumnsPanel Style="{StaticResource PageFormRow}">
                            <TextBlock Style="{StaticResource CredentialLabel}" Text="{Binding Credentials.ConfirmationLabel}" />
                            <ui:PasswordBox Style="{StaticResource CredentialField}"
                                            Password="{Binding Credentials.ConfirmationPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </layout:ResponsiveColumnsPanel>

                        <StackPanel Style="{StaticResource PageActionRow}">
                            <ui:Button Content="{Binding Credentials.SaveButtonText}" Appearance="Primary"
                                       Command="{Binding Credentials.ReplaceCommand}" />
                            <ui:Button Content="Cancelar" Margin="8,0,0,0" Appearance="Secondary"
                                       Command="{Binding Credentials.CancelEditCommand}" />
                            <ui:ProgressRing Style="{StaticResource CredentialProgressRing}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding Credentials.StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#0F7B0F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Credentials.HasStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="#C42B1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:Card>
        </layout:SpacedStackPanel>
    </layout:PageLayout>
</UserControl>
