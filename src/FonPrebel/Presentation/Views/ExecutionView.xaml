<UserControl x:Class="FonPrebel.Presentation.Views.ExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:FonPrebel.Presentation.Views.Shared">
    <!--
        Ficha V1 del diseño (§2.18): la pantalla donde el analista opera el lote. El contenido vive en un
        contenedor centrado de ancho máximo 960, con márgenes de 32 por lado y bloques separados por 16 a 24
        de aire, para que no quede pegado a los bordes ni amontonado. Las acciones quedan ancladas al pie
        para que INICIAR esté siempre a la vista, y la marca de agua del logo de la ventana queda detrás de
        las tarjetas, que son las que llevan el texto.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- Rótulo chico que precede a un dato: número grande, etiqueta chica (§2.18: muy gráfico). -->
        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BlockTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid MaxWidth="960"
                  Margin="32,24,32,16"
                  HorizontalAlignment="Center">
                <StackPanel>

                    <!-- Encabezado: centrado y con aire respecto del primer bloque. -->
                    <StackPanel MaxWidth="620" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>

                    <!-- Anexo D: aviso literal en tono suave mientras falte configuración obligatoria. -->
                    <ui:InfoBar Margin="0,16,0,0"
                                Severity="Warning"
                                IsClosable="False"
                                IsOpen="{Binding ShowsIncompleteConfigurationWarning, Mode=OneWay}"
                                Title="Configuración incompleta"
                                Message="{Binding IncompleteConfigurationWarningText, Mode=OneWay}" />

                    <!-- Lote activo: código, periodo, estado y fecha de inicio (§2.18). -->
                    <ui:Card Margin="0,20,0,0"
                             Padding="24,20"
                             Visibility="{Binding HasBatch, Converter={StaticResource BooleanToVisibility}}">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel MinWidth="220" Margin="0,0,24,0">
                                <TextBlock Text="Lote activo" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="{Binding BatchCode}"
                                           Margin="0,2,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExecutionText}"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.7" />
                            </StackPanel>

                            <StackPanel MinWidth="190" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Periodo" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="{Binding PeriodText}" Style="{StaticResource FieldValueText}" />
                                <TextBlock Text="{Binding StartedAtText}"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.7" />
                            </StackPanel>

                            <StackPanel MinWidth="160" VerticalAlignment="Center">
                                <TextBlock Text="Estado" Style="{StaticResource EyebrowText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="10"
                                             Height="10"
                                             VerticalAlignment="Center"
                                             Fill="{Binding BatchStatusColor}" />
                                    <TextBlock Text="{Binding BatchStatusText}"
                                               Margin="8,0,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding BatchStatusColor}" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </ui:Card>

                    <!-- Estado vacío: sin lote no hay datos que mostrar y no se inventa ninguno. -->
                    <ui:Card Margin="0,20,0,0"
                             Padding="24,20"
                             Visibility="{Binding ShowsEmptyState, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel MaxWidth="520" HorizontalAlignment="Center">
                            <!-- El glifo del icono sale del vocabulario de WPF-UI; Play24 es el mismo de la
                                 sección en la barra lateral y anuncia que acá se inicia el proceso. -->
                            <ui:SymbolIcon Symbol="Play24"
                                           FontSize="28"
                                           HorizontalAlignment="Center"
                                           Opacity="0.5" />
                            <TextBlock Text="{Binding EmptyStateTitle}"
                                       Margin="0,10,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EmptyStateDetailText}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Opacity="0.7" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Indicador de las cinco fases: siempre visible, con el punto de estado de cada una. -->
                    <ui:Card Margin="0,16,0,0" Padding="20,16,20,8">
                        <StackPanel>
                            <TextBlock Text="Fases del proceso"
                                       Style="{StaticResource BlockTitleText}"
                                       Margin="0,0,0,12" />
                            <shared:PhaseStepIndicator />
                        </StackPanel>
                    </ui:Card>

                    <!-- Una barra por fase, con su porcentaje y su contador real. -->
                    <ui:Card Margin="0,16,0,0"
                             Padding="20,16"
                             Visibility="{Binding ShowsPhaseBars, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Avance por fase"
                                       Style="{StaticResource BlockTitleText}"
                                       Margin="0,0,0,12" />
                            <shared:PhaseProgressList Margin="0,0,0,-16" />
                        </StackPanel>
                    </ui:Card>

                    <!-- §2.16 y §5.6: la fórmula del progreso general está pendiente, así que no se inventa. -->
                    <ui:InfoBar Margin="0,16,0,0"
                                Severity="Informational"
                                IsClosable="False"
                                IsOpen="True"
                                Title="Progreso general"
                                Message="{Binding GlobalProgressNotice, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--
            Pie anclado: las acciones del analista no se van con el desplazamiento, así INICIAR queda a la
            vista siempre. Ninguna arranca el proceso todavía: eso es el bloque B.
        -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="#1A000000"
                Padding="0,12,0,12"
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid MaxWidth="960"
                  Margin="32,0,32,0"
                  HorizontalAlignment="Center">
                <StackPanel>
                    <!-- Envolvente: en modo compacto los botones se envuelven en dos líneas en lugar de encimarse. -->
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="INICIAR"
                                   Appearance="Primary"
                                   MinWidth="120"
                                   Margin="0,0,8,4"
                                   Command="{Binding StartCommand}"
                                   IsEnabled="{Binding CanStart}"
                                   ToolTip="{Binding StartToolTip}"
                                   ToolTipService.ShowOnDisabled="True"
                                   AutomationProperties.Name="Iniciar el proceso" />

                        <ui:Button Content="REANUDAR"
                                   Appearance="Secondary"
                                   MinWidth="120"
                                   Margin="0,0,8,4"
                                   Command="{Binding ResumeCommand}"
                                   IsEnabled="{Binding CanResume}"
                                   ToolTip="{Binding ResumeToolTip}"
                                   ToolTipService.ShowOnDisabled="True"
                                   AutomationProperties.Name="Reanudar el lote interrumpido"
                                   Visibility="{Binding IsResumeAvailable, Converter={StaticResource BooleanToVisibility}}" />

                        <ui:Button Content="CANCELAR"
                                   Appearance="Danger"
                                   MinWidth="120"
                                   Margin="0,0,8,4"
                                   Command="{Binding CancelCommand}"
                                   IsEnabled="{Binding CanCancel}"
                                   ToolTip="{Binding CancelToolTip}"
                                   ToolTipService.ShowOnDisabled="True"
                                   AutomationProperties.Name="Cancelar el lote en ejecución"
                                   Visibility="{Binding IsBatchRunning, Converter={StaticResource BooleanToVisibility}}" />

                        <ui:Button Content="Actualizar estado"
                                   Appearance="Secondary"
                                   Margin="0,0,8,4"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Vuelve a leer el estado del lote desde la base local."
                                   AutomationProperties.Name="Actualizar el estado del lote" />

                        <ui:ProgressRing Width="18"
                                         Height="18"
                                         Margin="4,0,8,4"
                                         IsIndeterminate="True"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock Text="{Binding LastRefreshText}"
                                   Margin="0,0,0,4"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.6" />
                    </WrapPanel>

                    <TextBlock Text="{Binding ResumeTargetText}"
                               Margin="0,10,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               Visibility="{Binding IsResumeAvailable, Converter={StaticResource BooleanToVisibility}}" />

                    <!-- Resultado de la última acción, sin inventar datos que la base no dio. -->
                    <ui:InfoBar Margin="0,10,0,0"
                                IsClosable="False"
                                IsOpen="{Binding HasNotice, Mode=OneWay}"
                                Severity="{Binding NoticeSeverity}"
                                Title="Estado de la acción"
                                Message="{Binding NoticeText, Mode=OneWay}" />

                    <TextBlock Text="{Binding ReadErrorText}"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="#C42B1C"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasReadError, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
