<Application x:Class="FonPrebel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:FonPrebel.Presentation.Views"
             xmlns:viewModels="clr-namespace:FonPrebel.Presentation.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cada ViewModel de sección se muestra con su vista. La vista recibe el ViewModel como DataContext. -->
            <DataTemplate DataType="{x:Type viewModels:ExecutionViewModel}">
                <views:ExecutionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MetricsViewModel}">
                <views:MetricsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ConnectionsViewModel}">
                <views:ConnectionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
