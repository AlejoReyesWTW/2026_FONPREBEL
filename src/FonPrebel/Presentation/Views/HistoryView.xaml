<UserControl x:Class="FonPrebel.Presentation.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:FonPrebel.Presentation.Views.Layout"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FonPrebel;component/Presentation/Views/Layout/PageLayout.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        S25: marcador deliberado, no abandonado. Columna centrada de 820 con relleno de 32 y un estado vacío
        centrado en la pantalla que explica qué va a haber aquí cuando la sección esté construida.
    -->
    <layout:PageLayout HeaderTitle="{Binding Title}"
                       HeaderSubtitle="{Binding Description}"
                       ContentMaxWidth="820">
        <Grid>
            <StackPanel MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="History24"
                               FontSize="44"
                               HorizontalAlignment="Center"
                               Opacity="0.45" />
                <TextBlock Style="{StaticResource PageEmptyTitle}" Text="Todavía no hay lotes para consultar" />
                <TextBlock Style="{StaticResource PageEmptyText}"
                           Text="Cuando ejecutes el primer lote, aquí vas a ver cada ejecución con el estado de sus fases y el resultado de cada notificación, en modo consulta y sin poder modificar nada." />
            </StackPanel>
        </Grid>
    </layout:PageLayout>
</UserControl>
