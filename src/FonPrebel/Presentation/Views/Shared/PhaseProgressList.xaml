<UserControl x:Class="FonPrebel.Presentation.Views.Shared.PhaseProgressList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Una barra por fase (§2.18) con su porcentaje y su contador "procesados de total", leído de
        PhaseExecution.ProcessedCount y TotalCount. Sin total definido el porcentaje es "—" y la barra no
        se pinta: nunca un 0 % que el dato no respalde.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Phases}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountText}"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Opacity="0.75" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding PercentageText}"
                                   Margin="16,0,0,0"
                                   MinWidth="50"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="{Binding StatusColor}" />
                    </Grid>

                    <!--
                        WPF-UI 4.3.0 no expone un ProgressBar propio: se usa el ProgressBar de WPF, que
                        queda con el estilo Fluent del temas del ControlsDictionary, y así se respeta el
                        "aspecto Fluent" sin inventar un control a mano.
                    -->
                    <ProgressBar Margin="0,6,0,0"
                                 Height="8"
                                 Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 Foreground="{Binding StatusColor}"
                                 Visibility="{Binding HasKnownTotal, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
