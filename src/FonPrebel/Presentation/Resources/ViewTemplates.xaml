<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:FonPrebel.Presentation.Views"
                    xmlns:viewModels="clr-namespace:FonPrebel.Presentation.ViewModels">
    <!--
        S16: cada ViewModel de sección se muestra con su vista, y la vista recibe el ViewModel como
        DataContext. Las plantillas viven en su propio diccionario para que la aplicación las mezcle en
        App.xaml y para que una prueba pueda cargarlas y comprobar que la sección activa se convierte en
        la vista esperada. Sin estas plantillas el contenido de la ventana no cambia al navegar.
    -->
    <DataTemplate DataType="{x:Type viewModels:ExecutionViewModel}">
        <views:ExecutionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
        <views:HistoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:LogsViewModel}">
        <views:LogsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:MetricsViewModel}">
        <views:MetricsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:ConnectionsViewModel}">
        <views:ConnectionsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
        <views:LoginView />
    </DataTemplate>
</ResourceDictionary>
