<UserControl x:Class="FonPrebel.Presentation.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1"
                   Text="{Binding Description}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   MaxWidth="720"
                   HorizontalAlignment="Left" />

        <!-- Barra superior: día en curso, botón de actualización y estado de la lectura. -->
        <WrapPanel Grid.Row="2" Margin="0,16,0,12" Orientation="Horizontal">
            <TextBlock Text="Día:"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <TextBlock Text="{Binding SelectedDayText}"
                       Margin="6,0,16,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <ui:Button Content="Actualizar"
                       Command="{Binding RefreshCommand}"
                       Appearance="Secondary" />
            <ui:ProgressRing IsIndeterminate="True"
                             Width="18"
                             Height="18"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center">
                <ui:ProgressRing.Style>
                    <Style TargetType="ui:ProgressRing">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:ProgressRing.Style>
            </ui:ProgressRing>
            <TextBlock Text="{Binding ReadErrorText}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#C42B1C">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReadError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Sin actividad para este día"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Opacity="0.6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </WrapPanel>

        <!-- Dos paneles lado a lado: una bitácora por panel, sólo lectura. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="execution.log"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ExecutionLineCount, StringFormat={}{0} líneas}"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ExecutionLogText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="1" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="errors.log"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ErrorLineCount, StringFormat={}{0} líneas}"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ErrorLogText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
