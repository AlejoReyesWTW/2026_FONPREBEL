<UserControl x:Class="FonPrebel.Presentation.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:FonPrebel.Presentation.Views.Layout"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FonPrebel;component/Presentation/Views/Layout/PageLayout.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        S25: columna centrada de 1100 porque esta vista es de tarjetas, no de formulario: las dos tarjetas
        se reparten el ancho disponible y, cuando la ventana es angosta, ResponsiveColumnsPanel las apila.
    -->
    <layout:PageLayout HeaderTitle="{Binding Title}"
                       HeaderSubtitle="{Binding Description}"
                       ContentMaxWidth="1100">
        <layout:SpacedStackPanel>
            <!-- Barra superior: rechequeo automático, intervalo vigente y umbral de lentitud. -->
            <ui:Card Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <layout:SpacedStackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding AutoCheckText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SlowThresholdText}"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                        <TextBlock Text="{Binding LastReviewText}"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </layout:SpacedStackPanel>

                    <!--
                        Limpia sólo lo que se ve en los mini-logs. Los archivos de registro los escribe la
                        bitácora diaria y esta pantalla nunca los abre ni los recorta (S17, §2.14).
                    -->
                    <ui:Button Grid.Column="1"
                               Margin="16,0,0,0"
                               VerticalAlignment="Top"
                               Content="Limpiar vista"
                               Command="{Binding ClearViewCommand}"
                               ToolTip="Solo limpia lo que se ve en pantalla; no elimina ni recorta los archivos de registro en disco." />
                </Grid>
            </ui:Card>

            <!-- Dos tarjetas: servidor de archivos y correo, cada una con su punto, su mini-log y su botón. -->
            <ItemsControl ItemsSource="{Binding Targets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <layout:ResponsiveColumnsPanel ColumnPattern="*,*" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="16" VerticalAlignment="Stretch">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="14"
                                             Height="14"
                                             VerticalAlignment="Center"
                                             Fill="{Binding StatusBrush}" />
                                    <TextBlock Text="{Binding TargetName}"
                                               Margin="8,0,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Opacity="0.8" />
                                    <ui:ProgressRing IsIndeterminate="True"
                                                     Width="16"
                                                     Height="16"
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center">
                                        <ui:ProgressRing.Style>
                                            <Style TargetType="ui:ProgressRing">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:ProgressRing.Style>
                                    </ui:ProgressRing>
                                </StackPanel>

                                <TextBlock Text="{Binding LastAttemptText}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Opacity="0.75" />

                                <TextBlock Text="{Binding ReasonText}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#C42B1C">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasReason}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ui:Button Content="Comprobar conexión"
                                           Command="{Binding CheckCommand}"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Left" />

                                <TextBlock Text="Mini-log de intentos"
                                           Margin="0,16,0,0"
                                           FontWeight="SemiBold" />

                                <!-- Mini-log con alto acotado y desplazamiento propio: no empuja la tarjeta. -->
                                <Border Margin="0,8,0,0"
                                        Padding="8"
                                        Height="180"
                                        CornerRadius="4"
                                        Background="#08000000">
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding LogLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding EmptyLogText}"
                                                   Opacity="0.6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LogLines.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </layout:SpacedStackPanel>
    </layout:PageLayout>
</UserControl>
