<UserControl x:Class="FonPrebel.Presentation.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Title}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   MaxWidth="720" />
    </StackPanel>
</UserControl>
