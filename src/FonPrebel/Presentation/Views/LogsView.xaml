<UserControl x:Class="FonPrebel.Presentation.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:FonPrebel.Presentation.Views.Layout"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FonPrebel;component/Presentation/Views/Layout/PageLayout.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        S25: columna centrada de 1200 con relleno de 40: es una vista de paneles que reparten el ancho entre
        dos bitácoras, así que necesita más ancho que un formulario y algo más de aire lateral.
        BodyMode=Fill porque los dos paneles reparten el alto de la pantalla; en ventana angosta
        ResponsiveColumnsPanel los apila y cada uno conserva un alto acotado (StackedItemHeight) con
        desplazamiento propio, para que no crezcan con todo el texto de la bitácora.
    -->
    <layout:PageLayout HeaderTitle="{Binding Title}"
                       HeaderSubtitle="{Binding Description}"
                       ContentMaxWidth="1200"
                       PagePadding="40,0,40,0"
                       BodyMode="Fill">
        <Grid>
            <!--
                Las cuatro filas son explícitas y la de los paneles es la que sobra: los dos paneles reparten
                el alto disponible, y si se apilan en ventana angosta el Grid crece y la página se desplaza.
            -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra superior centrada: día en curso, botón de actualización y contadores de cada bitácora. -->
            <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="Día:"
                           VerticalAlignment="Center"
                           Opacity="0.7" />
                <TextBlock Text="{Binding SelectedDayText}"
                           Margin="6,0,16,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <ui:Button Content="Actualizar"
                           Command="{Binding RefreshCommand}"
                           Appearance="Secondary" />
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="18"
                                 Height="18"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center">
                    <ui:ProgressRing.Style>
                        <Style TargetType="ui:ProgressRing">
                            <!-- El anillo de fondo oscuro es el que se veía como un cuadro. -->
                            <Setter Property="Foreground" Value="#0078D4" />
                            <Setter Property="CoverRingVisibility" Value="Collapsed" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ProgressRing.Style>
                </ui:ProgressRing>
                <TextBlock Text="{Binding ExecutionLineCount, StringFormat={}{0} líneas}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.6" />
                <TextBlock Text="{Binding ErrorLineCount, StringFormat={}{0} líneas}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.6" />
            </WrapPanel>

            <!-- Avisos de la lectura: se muestran centrados bajo la barra, sin correr los paneles. -->
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Text="{Binding ReadErrorText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#C42B1C">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReadError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="2"
                       Margin="0,8,0,0"
                       Text="Sin actividad para este día"
                       HorizontalAlignment="Center"
                       Opacity="0.6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Dos paneles de igual ancho: una bitácora por panel, sólo lectura. -->
            <layout:ResponsiveColumnsPanel Grid.Row="3"
                                           Margin="0,12,0,0"
                                           ColumnPattern="*,*"
                                           Spacing="16"
                                           StackedItemHeight="180">
                <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="execution.log"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ExecutionLineCount, StringFormat={}{0} líneas}"
                                       Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ExecutionLogText}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="errors.log"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorLineCount, StringFormat={}{0} líneas}"
                                       Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ErrorLogText}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </ui:Card>
            </layout:ResponsiveColumnsPanel>
        </Grid>
    </layout:PageLayout>
</UserControl>
